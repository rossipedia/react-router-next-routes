{
  "name": "@rossipedia/react-router-next-routes",
  "version": "0.2.0",
  "description": "Next.js-inspired file-system routes for React Router framework mode",
  "type": "module",
  "license": "MIT",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test",
    "prepack": "pnpm build",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@react-router/dev": ">=7",
    "react-router": ">=7"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.1",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
